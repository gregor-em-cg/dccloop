        {
          "if": {
            "properties": {
              "operation": {
                "const": "render_arlette_v1"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "properties": {
                  "preview_px": {
                    "type": "integer",
                    "minimum": 64,
                    "maximum": 1200
                  },
                  "views": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "full",
                        "detail",
                        "alternate",
                        "clay",
                        "cage"
                      ]
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
