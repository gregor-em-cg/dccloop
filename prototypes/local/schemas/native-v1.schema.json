          "type": "object"
        },
        "expected_candidate": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "final_validation": {
          "type": "boolean"
        },
        "isolation_profile": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "version_v1"
              }
            },
            "required": [
              "operation"
            ]
          },
